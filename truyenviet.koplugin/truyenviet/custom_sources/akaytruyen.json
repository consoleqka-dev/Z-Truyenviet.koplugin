{
  "id": "akaytruyen",
  "name": "AkayTruyen",
  "kind": "text",
  "base_url": "https://akaytruyen.com",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36",
    "Referer": "https://akaytruyen.com/"
  },
  "completed": {
    "path": "/"
  },
  "search": {
    "path": "/tim-kiem?key_word={query}",
    "item_marker": "<div class=\"story-item-list ",
    "url_pattern": "href=\"(https?://akaytruyen%.com/truyen/[^\"]+)\"",
    "title_pattern": "story%-name\">%s*([^<]-)%s*</a>",
    "cover_pattern": "data%-src=[\"']([^\"']+)[\"']",
    "chapter_count_pattern": "story%-item%-list__chapter[^>]*>%s*[^%d<]-(%d+)",
    "completed_pattern": "text%-bg%-success[^>]*>%s*Full%s*<"
  },
  "story_details": {
    "description_pattern": "<div[^>]-class=[\"'][^\"']*desc[^\"']*[\"'][^>]*>([%s%S]-)</div>",
    "author_pattern": "itemprop=[\"']author[\"'][^>]*>([%s%S]-)</a>",
    "status_pattern": "<span[^>]-class=[\"'][^\"']*text%-success[^\"']*[\"'][^>]*>([%s%S]-)</span>"
  },
  "story_page": {
    "chapter_item_pattern": "<a[^>]+href=[\"']([^\"']+)[\"'][^>]+class=[\"'][^\"']*chapter%-link%-mobile[^\"']*[\"'][^>]*>([%s%S]-)</a>",
    "total_pages_pattern": "class=[\"']jump%-input[^\"']*[\"'][^>]-max=[\"'](%d+)[\"']"
  },
  "chapter": {
    "title_pattern": "<h[12][^>]*>([%s%S]-)</h[12]>",
    "content_pattern": "<div[^>]-id=[\"']chapter%-content[\"'][^>]*>([%s%S]-)</div>",
    "prev_url_pattern": "id=[\"']prev_chap[\"'][^>]+href=[\"']([^\"']+)[\"']",
    "next_url_pattern": "id=[\"']next_chap[\"'][^>]+href=[\"']([^\"']+)[\"']"
  }
}
