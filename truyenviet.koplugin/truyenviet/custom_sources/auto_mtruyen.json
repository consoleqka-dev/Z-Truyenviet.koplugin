{
  "id": "auto_mtruyen",
  "name": "mtruyen.net",
  "kind": "text",
  "base_url": "https://mtruyen.net",
  "matched_template": "Direct Importer Auto-Detected",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Referer": "https://mtruyen.net/"
  },
  "search": {
    "path": "/tim-kiem?q={query}",
    "item_marker": "<a class=\"group block ",
    "url_pattern": "href=\"([^\"]*/truyen/[^\"]*)\"",
    "title_pattern": "<h3[^>]*>([^<]*)</h3>",
    "cover_pattern": "src=\"([^\"]+)\"",
    "chapter_count_pattern": "<span>%d*[^<]-</span><span>([%d%.,]+)<!%-%- %-%-> chương</span>",
    "completed_pattern": "<span>Hoàn thành</span><span>[%d%.,]+<!%-%- %-%-> chương"
  },
  "story_details": {
    "description_pattern": "<div[^>]-class=\"[^\"]*desc[^\"]*\"[^>]*>([%s%S]-)</div>",
    "author_pattern": "author",
    "status_pattern": "status"
  },
  "story_page": {
    "chapter_item_pattern": "<a[^>]+href=\"([^\"]*/chuong%-[^\"]*)\"[^>]*>([%s%S]-)</a>",
    "total_pages_pattern": "trang%-(%d+)"
  },
  "chapter": {
    "title_pattern": "<h[12][^>]*>([%s%S]-)</h[12]>",
    "content_pattern": "<div[^>]-class=\"[^\"]*chapter%-content[^\"]*\"[^>]*>(.+)</div>",
    "prev_url_pattern": "href=\"([^\"]*/chuong%-%d+)\"[^>]*>Chương trước",
    "next_url_pattern": "href=\"([^\"]*/chuong%-%d+)\"[^>]*>Chương sau"
  }
}
